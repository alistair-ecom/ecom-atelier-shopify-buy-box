{
  "name": "@ecom-atelier/shopify-buy-box",
  "version": "0.1.0",
  "description": "Reusable Shopify + Discount Kit buy box for Ecom Atelier landing pages.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "shopify",
    "buy-box",
    "discount-kit",
    "lovable",
    "react"
  ],
  "license": "UNLICENSED"
}
